# ---- provider: "anthropic" or "openai" ----
CODESKATE_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- model routing ----
# Verify these IDs against your provider's model list, then run: codeskate doctor
# cheap  = high volume grunt work (filtering, scoring, extraction)
# smart  = quality-critical work (skill graph, resume tailoring)
CODESKATE_MODEL_CHEAP=claude-haiku-4-5
CODESKATE_MODEL_SMART=claude-sonnet-5
# for openai, e.g.:
# CODESKATE_MODEL_CHEAP=gpt-5.6-luna
# CODESKATE_MODEL_SMART=gpt-5.6-terra

# ---- SPEND GUARD (USD) ----
# Hard ceiling on cumulative API spend. The client refuses to call once hit.
# This is your protection against a buggy loop draining credits.
CODESKATE_SPEND_LIMIT_USD=20.00
