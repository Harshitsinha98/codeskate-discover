# Copy to deploy/.env on the server and fill in. Never commit the real file.

# ---- where this is reachable ----
# Must be a real domain with HTTPS: Google OAuth rejects anything else outside
# localhost. With no domain of your own, <your-public-ip>.sslip.io resolves to
# that IP and works with Let's Encrypt.
SITE_DOMAIN=your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# ---- database (Neon free tier — do NOT run Postgres on a 1 GB instance) ----
# Use the POOLED connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Google sign-in ----
# Authorised redirect URI must be exactly:
#   https://<SITE_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- the platform's own model key (users never supply one) ----
OPENAI_API_KEY=
LLM_PROVIDER=openai

# ---- owner access ----
# Comma-separated. Sign in with this Google account to get the Admin tab.
ADMIN_EMAILS=you@gmail.com

# ---- payments (optional at first; the app runs without it) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- safety rails ----
# Model usage is billed to you, so these are the ceiling on a bad day.
GLOBAL_DAILY_RUN_CAP=5000
PER_USER_HARD_USD_CEILING=25
